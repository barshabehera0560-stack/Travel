// Wanderly Travel & Tourism Management System Database Schema
// Targets SQLite for local zero-config execution; 100% compatible with PostgreSQL in production

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  role         String      @default("traveler") // traveler, moderator, admin
  preferences  String?     // Stored as JSON string (travelStyle, budgetTier, interests)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  trips        Trip[]
  favorites    Favorite[]
  reviews      Review[]

  @@map("users")
}

model Destination {
  id             String         @id @default(uuid())
  name           String
  country        String
  region         String
  category       String         // Beach, Mountain, Heritage, Adventure, Urban, Island
  bestSeason     String         // e.g., "Spring (Mar-May)", "Winter (Dec-Feb)"
  description    String
  avgCostTier    Int            @default(2) // 1 = Budget ($), 2 = Moderate ($$), 3 = Luxury ($$$)
  imageUrl       String
  heroImageUrl   String
  climateSummary String
  rating         Float          @default(4.8)
  reviewCount    Int            @default(0)
  lat            Float
  lng            Float
  createdAt      DateTime       @default(now())

  attractions    Attraction[]
  hotels         HotelCache[]
  trips          Trip[]
  reviews        Review[]
  weatherCache   WeatherCache[]

  @@map("destinations")
}

model Attraction {
  id              String      @id @default(uuid())
  destinationId   String
  name            String
  category        String      // Historical, Nature, Cultural, Food, Adventure, Sightseeing
  description     String
  lat             Float
  lng             Float
  avgVisitMinutes Int         @default(120)
  estimatedCost   Float       @default(0.0)
  imageUrl        String

  destination     Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@map("attractions")
}

model HotelCache {
  id            String      @id @default(uuid())
  destinationId String
  name          String
  pricePerNight Float
  rating        Float       @default(4.5)
  address       String
  amenities     String      // Comma-separated or JSON string
  imageUrl      String
  bookingUrl    String?

  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@map("hotels_cache")
}

model Trip {
  id            String         @id @default(uuid())
  userId        String
  destinationId String
  title         String
  startDate     DateTime
  endDate       DateTime
  travelerCount Int            @default(1)
  budgetCeiling Float          @default(2000.0)
  status        String         @default("planning") // planning, confirmed, completed
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination   Destination    @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  days          ItineraryDay[]

  @@map("trips")
}

model ItineraryDay {
  id         String          @id @default(uuid())
  tripId     String
  dayNumber  Int
  date       DateTime
  notes      String?

  trip       Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items      ItineraryItem[]

  @@map("itinerary_days")
}

model ItineraryItem {
  id             String       @id @default(uuid())
  itineraryDayId String
  itemType       String       // attraction, hotel, transport, custom, dining
  title          String
  description    String?
  cost           Float        @default(0.0)
  startTime      String?      // "09:00 AM"
  orderIndex     Int          @default(0)
  refId          String?      // Optional foreign key to Attraction or HotelCache

  itineraryDay   ItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)

  @@map("itinerary_items")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  itemType  String   // destination, attraction, hotel
  itemId    String
  title     String
  subtitle  String?
  imageUrl  String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
  @@map("favorites")
}

model Review {
  id            String      @id @default(uuid())
  userId        String
  destinationId String
  rating        Int         // 1 to 5 stars
  comment       String
  travelerType  String      @default("Solo") // Solo, Couple, Family, Friends
  photos        String?     // JSON array of photo URLs
  createdAt     DateTime    @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model WeatherCache {
  id            String      @id @default(uuid())
  destinationId String
  forecastDate  DateTime
  tempMin       Float
  tempMax       Float
  condition     String      // Sunny, Rainy, Cloudy, etc.
  icon          String      // e.g. "01d", "10d"
  humidity      Int
  fetchedAt     DateTime    @default(now())

  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@map("weather_cache")
}
